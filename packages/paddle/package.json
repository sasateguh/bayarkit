{
  "name": "@bayarkit/paddle",
  "version": "0.2.2",
  "description": "Paddle Billing (merchant of record) for Node.js and TypeScript: create one-time transactions, verify Paddle-Signature webhooks, confirm each payment with a fresh status query, and refund. Zero dependencies, part of bayarkit.",
