{
  "name": "bayarkit-monorepo",
  "private": true,
  "description": "Malaysian payment gateways behind one interface, and the safe way to confirm a payment.",
  "license": "MIT",
  "author": "Muhammad Aiman (https://github.com/aimanmalib)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasateguh/bayarkit.git"
  },
  "homepage": "https://github.com/sasateguh/bayarkit#readme",
  "bugs": {
    "url": "https://github.com/sasateguh/bayarkit/issues"
  },
  "keywords": [
    "payment",
    "payment-gateway",
    "malaysia",
    "fpx",
    "duitnow",
    "webhook",
    "checkout",
    "typescript"
  ],
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build -w @bayarkit/core && npm run build -w @bayarkit/testing && npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "gate": "bash scripts/gate.sh",
    "demo": "node examples/demo/server.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
