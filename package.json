{
  "name": "bayarkit-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/testing",
    "packages/toyyibpay",
    "packages/bayarcash",
    "packages/billplz",
    "packages/stripe",
    "packages/chip"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "gate": "bash scripts/gate.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
